# Base de locus-core (serveur uniquement). Vide → l'agent tourne en mode simulé, sans backend.
LOCUS_CORE_URL=http://localhost:8000
# Clé lsk_… Ne franchit jamais le navigateur. Vide → mode keyless (Sandbox /console/retrieve de core).
LOCUS_API_KEY=

# Le composer (⌘K) : un modèle frontière compose des actions dans le LGC, Locus en outil.
# Vide → composeur à règles (même plan, compréhension plus courte).
ANTHROPIC_API_KEY=

# --- Routes live (/api/compose, /api/note, /api/locus/*) : voir src/lib/server/guard.ts ---
# En production (VERCEL_ENV=production, ou NODE_ENV=production hors Vercel), les routes live
# répondent 403 et le navigateur bascule sur les scénarios rejoués. Previews et `next dev` restent ouverts.
# Jeton interne pour les tests : en-tête `x-studio-live-token: <STUDIO_LIVE_TOKEN>`. Ne jamais le committer.
STUDIO_LIVE_TOKEN=
# Force le verrou : 1 (fermé) ou 0 (ouvert). Vide → selon l'environnement ci-dessus.
STUDIO_LIVE_LOCK=
# Rate limit par IP et par heure (hors `next dev`) ; 0 désactive.
STUDIO_RATE_LIMIT_PER_HOUR=20
STUDIO_REPLAY_RATE_LIMIT_PER_HOUR=200
# Compteur partagé entre instances (Upstash Redis, API REST). Vide → compteur en mémoire de l'instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Unités logiques supplémentaires relayées par /api/locus/logic (liste séparée par des virgules).
STUDIO_MKU_ALLOWLIST=

# URL publique du site (metadata, Open Graph, hreflang). Vide → l'URL de production Vercel, ou localhost.
NEXT_PUBLIC_SITE_URL=

# --- Scribe : dictée au micro en temps réel (/api/scribe/stt), comptes invités seulement ---
# Clé serveur du service de transcription : elle émet des jetons éphémères (POST /v1/client/sessions), ne franchit jamais le navigateur.
# Vide → la consultation en direct reste possible en saisie ou collage de la transcription.
# Lue aussi au build (CSP connect-src) : redéployer après l’avoir posée.
MISTRAL_API_KEY=
# Minutes de dictée par compte et par jour (blocs de 5 min, hors `next dev`) ; 0 ne limite pas.
STUDIO_SCRIBE_MINUTES_PER_DAY=60
# Modèle de transcription en temps réel. Vide → voxtral-mini-transcribe-realtime-2602.
SCRIBE_STT_MODEL=
